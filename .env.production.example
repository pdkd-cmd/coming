# Copy this file to .env on the server and replace every placeholder.
NODE_ENV=production
PORT=5000

# Use a long, unique, randomly generated secret.
JWT_SECRET=replace-with-a-long-random-secret

# Keep the SQLite database on persistent storage outside ephemeral containers.
DATABASE_PATH=database/database.db

ADMIN_USERNAME=pdkd_admin
ADMIN_PASSWORD=replace-with-a-strong-password
